{
  "name": "@ghuri/tenants",
  "version": "0.1.0-alpha.0",
  "description": "Ghuri tenants: shared-schema multi-tenancy with fail-closed, tenant-scoped models, managers and QuerySets",
  "type": "module",
  "license": "MIT",
  "author": "Ghuri contributors",
  "homepage": "https://github.com/ghurijs/tenants#readme",
  "repository": { "type": "git", "url": "git+https://github.com/ghurijs/tenants.git" },
